r.jsx":"28","C:\\licenta\\cjc-frontend\\src\\pages\\MainPage\\MainPage.jsx":"29","C:\\licenta\\cjc-frontend\\src\\pages\\MainPageUser\\MainPageUser.jsx":"30","C:\\licenta\\cjc-frontend\\src\\pages\\AddQuestion\\AddQuestion.jsx":"31","C:\\licenta\\cjc-frontend\\src\\components\\Test\\Test.jsx":"32","C:\\licenta\\cjc-frontend\\src\\components\\ImageCarousel\\ImageCarousel.jsx":"33","C:\\licenta\\cjc-frontend\\src\\components\\QuestionShort\\Question.jsx":"34","C:\\licenta\\cjc-frontend\\src\\components\\viewQuestion\\ViewQuestion.jsx":"35","C:\\licenta\\cjc-frontend\\src\\components\\PDFViewer\\PDFViewer.jsx":"36","C:\\licenta\\cjc-frontend\\src\\services\\file_api.js":"37","C:\\licenta\\cjc-frontend\\src\\components\\DatePickerSidebar\\DatePicker.jsx":"38","C:\\licenta\\cjc-frontend\\src\\components\\ScheduleUser\\ScheduleUser.jsx":"39","C:\\licenta\\cjc-frontend\\src\\components\\Calendar\\Calendar.jsx":"40","C:\\licenta\\cjc-frontend\\src\\components\\SideBar\\SideBar.jsx":"41","C:\\licenta\\cjc-frontend\\src\\pages\\WaitingQuestions\\WaitingQuestions.jsx":"42","C:\\licenta\\cjc-frontend\\src\\Layouts\\SideBarLayout\\SideBarLayout.jsx":"43","C:\\licenta\\cjc-frontend\\src\\Layouts\\NavBarLayout\\NavBarLayout.jsx":"44","C:\\licenta\\cjc-frontend\\src\\pages\\RejectedQuestions\\RejectedQuestions.jsx":"45","C:\\licenta\\cjc-frontend\\src\\pages\\AcceptedQuestions\\AcceptedQuestions.jsx":"46","C:\\licenta\\cjc-frontend\\src\\pages\\WorkingQuestions\\WorkingQuestions.jsx":"47"},{"size":308,"mtime":1694942181542,"results":"48","hashOfConfig":"49"},{"size":3249,"mtime":1696529505268,"results":"50","hashOfConfig":"49"},{"size":747,"mtime":1694104602517,"results":"51","hashOfConfig":"49"},{"size":20151,"mtime":1694805375823,"results":"52","hashOfConfig":"49"},{"size":20018,"mtime":1695222850852,"results":"53","hashOfConfig":"49"},{"size":2476,"mtime":1694844501349,"results":"54","hashOfConfig":"49"},{"size":841,"mtime":1695577131293,"results":"55","hashOfConfig":"49"},{"siz