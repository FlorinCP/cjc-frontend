r.jsx":"28","C:\\licenta\\cjc-frontend\\src\\pages\\MainPage\\MainPage.jsx":"29","C:\\licenta\\cjc-frontend\\src\\pages\\MainPageUser\\MainPageUser.jsx":"30","C:\\licenta\\cjc-frontend\\src\\pages\\AddQuestion\\AddQuestion.jsx":"31","C:\\licenta\\cjc-frontend\\src\\components\\Test\\Test.jsx":"32","C:\\licenta\\cjc-frontend\\src\\components\\ImageCarousel\\ImageCarousel.jsx":"33","C:\\licenta\\cjc-frontend\\src\\components\\QuestionShort\\Question.jsx":"34","C:\\licenta\\cjc-frontend\\src\\components\\viewQuestion\\ViewQuestion.jsx":"35","C:\\licenta\\cjc-frontend\\src\\components\\PDFViewer\\PDFViewer.jsx":"36","C:\\licenta\\cjc-frontend\\src\\services\\file_api.js":"37"},{"size":308,"mtime":1694942181542,"results":"38","hashOfConfig":"39"},{"size":2012,"mtime":1695912062558,"results":"40","hashOfConfig":"39"},{"size":747,"mtime":1694104602517,"results":"41","hashOfConfig":"39"},{"size":20151,"mtime":1694805375823,"results":"42","hashOfConfig":"39"},{"size":20018,"mtime":1695222850852,"results":"43","hashOfConfig":"39"},{"size":2476,"mtime":1694844501349,"results":"44","hashOfConfig":"39"},{"size":841,"mtime":1695577131293,"results":"45","hashOfConfig":"39"},{"size":231,"mtime":1694893573054,"results":"46","hashOfConfig":"39"},{"size":4331,"mtime":1694955447816,"results":"47","hashOfConfig":"39"},{"size":443,"mtime":1694955536108,"results":"48","hashOfConfig":"39"},{"size":4847,"mtime":1695974570404,"results":"49","hashOfConfig":"39"},{"size":4991,"mtime":1695968599517,"results":"50","hashOfConfig":"39"},{"size":2435,"mtime":1695752251628,"results":"51","hashOfConfig":"39"},{"size":4319,"mtime":1695886358419,"results":"52","hashOfConfig":"39"},{"size":4576,"mtime":1695981712217,"results":"53","hashOfConfig":"39"},{"size":10150,"mtime":1695652030915,"results":"54","hashOfConfig":"39"},{"size":6317,"mtime":1695455578725,"results":"55","hashOfConfig":"39"},{"size":2038,"mtime":1695486420955,"results":"56","hashOfConfig":"39"},{"size":310,"mtime":1695494637948,"results